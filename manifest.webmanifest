{
  "name": "MDx",
  "short_name": "MDx",
  "description": "Escribe en Markdown, míralo, imprímelo en PDF y llévate un solo archivo HTML. Con catálogo de plantillas para Claude Code, documentos y reglas.",
  "lang": "es",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "id": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#ffffff",
  "theme_color": "#2f7bff",
  "categories": ["productivity", "utilities"],
  "icons": [
    { "src": "iconos/icono.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "iconos/icono-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "iconos/icono-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "iconos/icono-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "text/markdown": [".md", ".markdown", ".mdown", ".mkd"],
        "text/plain": [".txt"]
      },
      "icons": [
        { "src": "iconos/icono-192.png", "sizes": "192x192", "type": "image/png" }
      ]
    }
  ],
  "shortcuts": [
    {
      "name": "Documento nuevo",
      "short_name": "Nuevo",
      "description": "Empezar un documento en blanco",
      "url": "./?nuevo=1",
      "icons": [{ "src": "iconos/icono-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Plantillas",
      "short_name": "Plantillas",
      "description": "Abrir el catálogo de plantillas",
      "url": "./?plantillas=1",
      "icons": [{ "src": "iconos/icono-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
